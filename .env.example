# Copie para .env e preencha. Nunca coloque o .env no git.

# development | testing | production
FLASK_CONFIG=development

# Chave secreta do Flask. Em produção: gere com
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Banco principal. Aceita mysql:// (formato do Railway) ou mysql+pymysql://
DATABASE_URL=mysql+pymysql://boletim:boletim@127.0.0.1:3306/boletim

# Banco de testes. O nome precisa terminar em _test.
TEST_DATABASE_URL=mysql+pymysql://boletim:boletim@127.0.0.1:3307/boletim_test
